# =============================================================================
# Base de datos
# =============================================================================
#
# ENTORNO SENA (sin clave local de PostgreSQL):
#   Use SQLite. Copie este archivo a .env y deje la linea de SQLite activa.
#
# ENTORNO LOCAL / CASA (con PostgreSQL + pgAdmin 4):
#   Comente SQLite y configure PostgreSQL con su usuario y clave reales.
#
# El motor se elige SOLO con DATABASE_URL; no hace falta cambiar codigo.

# Opcion por defecto para laboratorio SENA (archivo local database.db)
DATABASE_URL=sqlite:///./database.db

# Opcion PostgreSQL (pgAdmin 4) — descomente y ajuste credenciales
# DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/db_companias

APP_NAME=API Companias y Empleados
DEBUG=False
